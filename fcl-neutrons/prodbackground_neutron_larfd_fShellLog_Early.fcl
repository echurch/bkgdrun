#include "services_dune.fcl"
#include "largeantmodules_dune.fcl"
#include "LArG4_dune.fcl"
#include "IonAndScint_dune.fcl"
#include "elecdrift_dune.fcl"
###include "PDFastSim_dune.fcl"
#include "services_dune.fcl"


BEGIN_PROLOG

larfd_neutron:

{
 module_type:           "RadioGen"
 Nuclide:               ["SS304L_U_Early"]
## Material:              [".*",".*",".*",".*",".*", ".*"]
## Material:              ["RadioS460ML"]
 Material:              ["SS304L"]
 ## Volume is optional, but allows to constrain decays from Material && Volume
 ## Be sure this your Material is in your Volume, else no decays will happen.
 Volume:                ["fShellLog"]
 BqPercc:               [ 0.0000076 ]
 X0:                    [  -991.0  ]  
# X1:                    [   990.0  ]
 X1:                    [  2000.0  ]
 Y0:                    [  -888.0  ]
 Y1:                    [  1428.0  ]
 Z0:                    [  -536.0  ]
 Z1:                    [ 14534.0  ]
 T0:                    [ -2246000. ] # ending time in ns
 T1:                    [  2246000. ] # ending time in ns
}

END_PROLOG

process_name: NeutronGen

services:
{

  TFileService:          { fileName: "neutrons_fShellLog_U_Early-hist.root" }
  TimeTracker:           {}
  MemoryTracker:         { } # default is one
  RandomNumberGenerator: {}                 # ART native random number generator
  FileCatalogMetadata:  @local::art_file_catalog_mc

  @table::dunefdvd_simulation_services
}


source:
{
  module_type: EmptyEvent
#  module_type: RootInput
  timestampPlugin: { plugin_type: "GeneratedEventTimestamp" }
  maxEvents:   10          # Number of events to create
  firstRun:    12           # Run number to use for this file
  firstEvent:  1           # number of first event in the file
}

physics:
{
  producers:
  {
    cNeutronGen: @local::larfd_neutron      #Originally use for K40 in Field Cage. Now repurposed  for Neutrons from concrete.
    largeant:  @local::dunefd_larg4
     IonAndScint: @local::dunefdvd_ionandscint
     IonAndScintExternal: @local::dunefdvd_ionandscint_external
     elecDrift:   @local::dunefd_elecdrift

    rns:       { module_type: "RandomNumberSaver" }
  }

  analyzers:
  {
    largana:   @local::standard_largeantana
  }

 
  # simulate:      [ rns, ar39Gen, ar42Gen, apaGen, cNeutronGen, cpaGen, kr85Gen, rn222Gen, po210Gen ]
  # simulate:      [ rns, ar39Gen, apaGen, cNeutronGen, cpaGen, kr85Gen, rn222Gen, po210Gen ]
  simulate:	 [ rns, cNeutronGen, largeant ]
  larana:	 [ largana ]
  stream1:       [ out1 ]
  trigger_paths: [ simulate ] 
#  end_paths:     [ larana, stream1 ]  
  end_paths:     [ larana ]  
}

outputs:
{
  out1:
  {
    module_type: RootOutput
    fileName:    "prodradiological_neutron_larfd_volBeams.root" # Default file name, can override from command line with -o or --output
    dataTier:    "generated"
    compressionLevel: 1
  }
}

services.Geometry.ValidateGDML: false
#services.AuxDetGeometry.GDML: "dunevd10kt_v7_full10kt_support_cavern_wires.gdml"
#services.Geometry.GDML: "dunevd10kt_v7_full10kt_support_cavern_wires.gdml"
#services.Geometry.GDML: "dunevd10kt_v6_full10kt_support_cavern_wires.gdml" ## pulled down from dungpvm
services.Geometry.GDML: "dunevd10kt_v7_full10kt_ggd_wires.gdml"
services.AuxDetGeometry.GDML: "dunevd10kt_v7_full10kt_ggd_wires.gdml"

services.LArG4Parameters.PhysicsList: "Shielding"
##services.Geometry.GDML.SurfaceY: 140000

physics.producers.largeant.inputCollections: [ "cNeutronGen" ]
physics.analyzers.largana.TruthModuleLabel: "cNeutronGen"
physics.analyzers.largana.Ndaughters: 20 

services.LArPropertiesService.ScintYield: 0
services.message: @local::standard_info

#services.message.standard_info.destinations.infomsg.type: "file"
#services.message.standard_info.destinations.infomsg.file: "./bkgd-msgs.out"
#services.message.destinations.debugmsg.type: "file"
#services.message.destinations.debugmsg.filename: "./bkgd-msgs.out"

